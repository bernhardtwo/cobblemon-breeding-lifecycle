{
  "schemaVersion": 1,
  "id": "breedinglifecycle",
  "version": "${version}",
  "name": "Breeding Lifecycle",
  "description": "An addition to a breeding system: after each breeding, every parent has a growing, per-parent chance of being lost instead of always being consumed.",
  "authors": ["Bernardo Vega"],
  "contact": {
    "homepage": "https://github.com/bernhardtwo/cobblemon-breeding-lifecycle",
    "sources": "https://github.com/bernhardtwo/cobblemon-breeding-lifecycle",
    "issues": "https://github.com/bernhardtwo/cobblemon-breeding-lifecycle/issues"
  },
  "license": "MIT",
  "icon": "assets/breedinglifecycle/icon.png",
  "environment": "server",
  "entrypoints": {
    "server": ["io.github.bernhardtwo.breedinglifecycle.mod.BreedingLifecycleMod"]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "cobblemon": ">=1.7.3+1.21.1",
    "server_translations_api": "*"
  }
}
